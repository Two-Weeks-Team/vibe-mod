{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "vibe-mod",
  "server": { "dir": "dist/server", "entry": "index.cjs" },
  "marketingAssets": { "icon": "assets/icon.png" },
  "permissions": {
    "reddit": { "enable": true },
    "redis": true,
    "http": { "enable": true, "domains": ["api.openai.com"] }
  },
  "settings": {
    "global": {
      "openaiApiKey": {
        "type": "string",
        "label": "Developer OpenAI API Key (sk-…)",
        "isSecret": true,
        "helpText": "Devvit secrets are global and encrypted: only the app developer can set or read this key. Every subreddit install of vibe-mod compiles through this single shared key, with a per-subreddit daily quota to bound cost. Set after the first upload: `npx devvit settings set openaiApiKey`."
      },
      "openaiModel": {
        "type": "select",
        "label": "OpenAI model for rule compilation (reasoning_effort: none, verbosity: low)",
        "options": [
          {
            "label": "gpt-5.4-mini (recommended — fastest ~1.1s, 7/7 on the rule-compile smoke test)",
            "value": "gpt-5.4-mini"
          },
          {
            "label": "gpt-5.4-nano (cheapest, ~1.4s, also 7/7)",
            "value": "gpt-5.4-nano"
          },
          {
            "label": "gpt-5.4 (full — slower ~1.8s, more cautious about ambiguous rules; no quality gain for this task)",
            "value": "gpt-5.4"
          }
        ],
        "defaultValue": "gpt-5.4-mini"
      }
    },
    "subreddit": {
      "dryRunOnly": {
        "type": "boolean",
        "label": "Dry-run mode (rules log what they would do, but never act)",
        "defaultValue": true
      },
      "maxActionsPerHour": {
        "type": "number",
        "label": "Auto-pause if more than N actions per hour (safety brake)",
        "validationEndpoint": "/internal/settings/validate-rate-limit",
        "defaultValue": 100
      },
      "shadowDurationHours": {
        "type": "number",
        "label": "Shadow-mode duration before a new rule can go live (hours)",
        "validationEndpoint": "/internal/settings/validate-shadow",
        "defaultValue": 24
      }
    }
  },
  "menu": {
    "items": [
      {
        "label": "vibe-mod: Compose rule",
        "description": "Write a moderation rule in plain English",
        "forUserType": "moderator",
        "location": ["subreddit"],
        "endpoint": "/internal/menu/compose-rule"
      },
      {
        "label": "vibe-mod: View rules + log",
        "description": "See active rules, recent actions, undo",
        "forUserType": "moderator",
        "location": ["subreddit"],
        "endpoint": "/internal/menu/dashboard"
      },
      {
        "label": "vibe-mod: Manage rules",
        "description": "Activate / pause / delete rules per-rule",
        "forUserType": "moderator",
        "location": ["subreddit"],
        "endpoint": "/internal/menu/manage-rules"
      },
      {
        "label": "vibe-mod: Undo this action",
        "description": "Restore the post (rule-triggered removals only)",
        "forUserType": "moderator",
        "location": ["post", "comment"],
        "endpoint": "/internal/menu/undo-action"
      }
    ]
  },
  "forms": {
    "ruleComposerForm": "/internal/form/compose-rule-submit",
    "composeConfirmForm": "/internal/form/compose-confirm-submit",
    "dashboardForm": "/internal/form/dashboard-action",
    "manageRulesForm": "/internal/form/manage-rules-submit",
    "manageDeleteConfirmForm": "/internal/form/manage-delete-confirm"
  },
  "triggers": {
    "onPostSubmit": "/internal/trigger/on-post-submit",
    "onCommentSubmit": "/internal/trigger/on-comment-submit",
    "onPostReport": "/internal/trigger/on-post-report",
    "onCommentReport": "/internal/trigger/on-comment-report",
    "onPostFlairUpdate": "/internal/trigger/on-post-flair-update"
  },
  "scheduler": {
    "tasks": {
      "audit-retention": {
        "endpoint": "/internal/scheduler/audit-retention",
        "cron": "0 3 * * *"
      },
      "dry-run-replay": {
        "endpoint": "/internal/scheduler/dry-run-replay"
      },
      "seed-on-install": {
        "endpoint": "/internal/scheduler/seed-on-install"
      },
      "shadow-promote-check": {
        "endpoint": "/internal/scheduler/shadow-promote-check",
        "cron": "*/15 * * * *"
      },
      "rate-limit-circuit-breaker": {
        "endpoint": "/internal/scheduler/rate-limit-circuit-breaker",
        "cron": "*/5 * * * *"
      }
    }
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build"
  },
  "dev": {
    "subreddit": "SocialSeeding"
  }
}
