# Copy to `.env` (git-ignored) for local-only tools — NOT used by the deployed app.
# The deployed app reads its key from a Devvit secret instead:  npm run settings:set:openai
#
#   cp .env.example .env   &&   edit .env

# OpenAI key used by `npm run openai:smoketest` (hits the real API once, ~$0.005/run).
OPENAI_API_KEY=sk-...

# Optional: override the model the smoke test uses (default: gpt-5.4-nano).
# OPENAI_MODEL=gpt-5.4-mini

# ─── LOCAL-ONLY PLAYTEST ESCAPE HATCHES ────────────────────────────────────
# These flags are read by `vite build` for `npx devvit playtest` ONLY. The
# deployed Reddit runtime does not set them — production behaviour is to
# read every value from Devvit settings via `settings.get(...)`.

# When the Devvit `settings` plugin RPC is unreachable inside the runtime
# (we saw this on r/SocialSeeding 2026-05-13), set this to a falsy 'mock' to
# bypass settings.get + fetch entirely in callOpenAI and return a fixed,
# deterministic fake compiled rule. Useful for testing the compose-rule
# UI flow when the platform is misbehaving. Unset / any other value =
# normal OpenAI call path.
# VIBE_MOD_AI_PROVIDER=mock

# `OPENAI_API_KEY` above is also picked up as a fallback by `callOpenAI`
# inside the request handler whenever `settings.get('openaiApiKey')` returns
# an empty string in the local playtest runtime. This is the officially-
# documented Devvit pattern (capabilities/server/settings-and-secrets.mdx
# — "Local environment variables and .env files are read during playtesting
# only"). Reddit production runtime does NOT set process.env, so the
# fallback is a no-op there.
